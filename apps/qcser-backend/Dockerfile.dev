# Development stage only - no build step
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Ajustes para hot-reload dentro de contenedor (útiles en Docker Desktop Windows/Mac)
ENV CHOKIDAR_USEPOLLING=true \
    CHOKIDAR_INTERVAL=300 \
    WATCHPACK_POLLING=true \
    NODE_ENV=development \
    HOST=0.0.0.0 \
    PORT=3000

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "start:dev"]