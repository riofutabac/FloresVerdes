# Variables de entorno - FloresVerdes
# NUNCA subas el archivo .env real al repositorio

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/flores_verdes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# API
API_PORT=3001
API_HOST=localhost
API_BASE_URL=http://localhost:3001

# File Storage
STORAGE_BUCKET=flores-verdes-files
MAX_FILE_SIZE=10MB

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Ambiente
NODE_ENV=development
LOG_LEVEL=debug

# Sync Settings
SYNC_INTERVAL_MS=30000
OFFLINE_CACHE_TTL=86400000