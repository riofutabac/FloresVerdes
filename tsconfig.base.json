{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@flores-verdes/shared-types/*": ["packages/shared-types/src/*"],
      "@flores-verdes/shared-config/*": ["packages/shared-config/src/*"]
    }
  }
}